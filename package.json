{
  "name": "austerlitz-command-map",
  "private": true,
  "description": "Interactive reconstruction of the Battle of Austerlitz (2 December 1805): one self-contained HTML built from source.",
  "scripts": {
    "build": "python3 build.py",
    "test": "sh tools/run-all.sh",
    "check:baseline": "python3 build.py && node -e \"const h=require('crypto').createHash('md5').update(require('fs').readFileSync('austerlitz-command-map.html')).digest('hex');console.log(h);process.exit(h==='c09c4b23d9e245ff9d693960cf9496b9'?0:1)\"",
    "check:data": "node tools/visual/data-invariance.js archive/stage0-c09c4b23.html austerlitz-command-map.html",
    "check:visual": "node tools/visual/harness.js austerlitz-command-map.html tools/visual/out --test",
    "check:report": "node tools/visual/check-report.js tools/visual/out"
  },
  "devDependencies": { "acorn": "8.18.0", "playwright": "1.56.0", "three": "0.128.0" }
}
